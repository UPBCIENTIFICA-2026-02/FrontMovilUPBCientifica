<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de seguridad de red — SOLO PARA DESARROLLO.
    Permite tráfico HTTP sin cifrar (cleartext) hacia el mock local y los
    servidores del laboratorio mientras se desarrolla.

    Si una dirección NO está en esta lista, Android corta la conexión sin
    mensaje útil y parece que el servidor está caído. Al añadir una IP nueva
    en Configuracion.kt hay que añadirla también aquí.

    >>> IMPORTANTE ANTES DE PRODUCCIÓN <
    El roadmap exige TLS/cifrado en producción. Antes de entregar/desplegar:
    - Quitar estas direcciones o poner cleartextTrafficPermitted="false".
    - Los servicios reales del CCA deben exponerse por HTTPS.
-->
<network-security-config>
    <!--
        CA interna de UPB-CIENTIFICA: firma los certificados de node-soap
        (HTTPS 8081) y node-sync (gRPC/TLS 9090) en las VPS. Sin ella Android
        rechaza el login y la sincronización por "certificado desconocido".
        Es pública (también en https://10.154.12.219/upbc-ca.crt).
    -->
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/upbc_ca" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!--
            Emulador de Android Studio: 10.0.2.2 es la dirección con la que el
            emulador ve el "localhost" del PC anfitrión. Faltaba, así que con
            Entorno.EMULADOR todas las llamadas morían aquí.
        -->
        <domain includeSubdomains="true">10.0.2.2</domain>

        <!--
            Celular físico en la misma Wi-Fi: IP del PC de desarrollo.
            Debe coincidir con Configuracion.IP_PC_EN_WIFI.
        -->
        <domain includeSubdomains="true">192.168.20.31</domain>

        <!-- Celular conectado a la zona con cobertura (hotspot) del PC. -->
        <domain includeSubdomains="true">192.168.137.1</domain>

        <!--
            VPS del laboratorio (servicios REST todavía en HTTP).
            node-soap (10.154.12.219) va por HTTPS y no necesita estar aquí.
        -->
        <domain includeSubdomains="true">10.154.12.221</domain> <!-- pasd_nodo2: Storage, Shared File -->
        <domain includeSubdomains="true">10.154.12.222</domain> <!-- pasd_nodo3: Media, job-api -->

        <!-- VM antigua del laboratorio (antes de las VPS). -->
        <domain includeSubdomains="true">192.168.1.195</domain>
    </domain-config>
</network-security-config>
